@@ -52,3 +52,11 @@
   }
   return result;
 }
+
+// Optional FH1 native-mod presentation correction. One leaves normal rendering unchanged.
+REXCVAR_DEFINE_DOUBLE(forza_hud_horizontal_scale, 1.0, "GPU",
+                    "Native mod: preserve FH1 HUD proportions in an ultrawide presentation")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+REXCVAR_DEFINE_BOOL(forza_present_16_9, false, "GPU",
+                    "Native mod: treat FH1's original image as 16:9 before presentation");
