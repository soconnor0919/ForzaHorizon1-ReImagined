 #include <glslang/Public/ShaderLang.h>
 #include <rex/assert.h>
 #include <rex/cvar.h>
+REXCVAR_DECLARE(double, forza_hud_horizontal_scale);
+REXCVAR_DECLARE(bool, forza_present_16_9);
 #include <rex/dbg.h>
 #include <rex/logging.h>
 #include <rex/math.h>
@@ -2697,6 +2699,10 @@
   kernel::xboxkrnl::VdQueryVideoMode(&video_mode);
   uint32_t display_width = std::max(uint32_t(1), uint32_t(video_mode.display_width));
   uint32_t display_height = std::max(uint32_t(1), uint32_t(video_mode.display_height));
+  if (REXCVAR_GET(forza_present_16_9)) {
+    display_width = 16;
+    display_height = 9;
+  }
 
   presenter->RefreshGuestOutput(
       guest_output_width, guest_output_height, display_width, display_height,
@@ -4292,6 +4298,16 @@
       host_render_targets_used && render_target_cache_->depth_float24_convert_in_pixel_shader(),
       host_render_targets_used, pixel_shader && pixel_shader->writes_depth(), viewport_info);
 
+  // FH1 draws its HUD to the packed 10-bit front-buffer view. Scale only
+  // those draws, leaving the world, shadows and reflections untouched.
+  const double hud_scale = REXCVAR_GET(forza_hud_horizontal_scale);
+  if (hud_scale > 1.0 && hud_scale <= 4.0 && normalized_color_mask &&
+      regs.Get<reg::RB_COLOR_INFO>(XE_GPU_REG_RB_COLOR_INFO).color_format ==
+          xenos::ColorRenderTargetFormat::k_2_10_10_10_AS_10_10_10_10) {
+    viewport_info.ndc_scale[0] = float(viewport_info.ndc_scale[0] / hud_scale);
+    viewport_info.ndc_offset[0] = float(viewport_info.ndc_offset[0] / hud_scale);
+  }
+
   // Update dynamic graphics pipeline state.
   UpdateDynamicState(viewport_info, primitive_polygonal, normalized_depth_control);
 
